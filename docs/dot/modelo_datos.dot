digraph G { rankdir=LR; nodesep=0.5; ranksep=0.8; graph [fontname="Inter", bgcolor="white", pad=0.25, dpi=200]; node [fontname="Inter", fontsize=11, shape=box, style="rounded,filled", fillcolor="#F7F3EC", color="#9AA6A0", penwidth=1.3, margin="0.18,0.10"]; edge [fontname="Inter", fontsize=9.5, color="#5B6B64", arrowsize=0.8, penwidth=1.3];
 node [shape=plaintext, style="", margin=0];
 Group [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#1E6B52"><tr><td bgcolor="#1E6B52"><font color="white"><b>Group</b></font></td></tr><tr><td align="left">id : string<br align="left"/>name : string<br align="left"/>emoji : string<br align="left"/>meId : string (→ Member)<br align="left"/>createdAt : date<br align="left"/></td></tr></table>>];
 Member [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#3B6FB6"><tr><td bgcolor="#3B6FB6"><font color="white"><b>Member</b></font></td></tr><tr><td align="left">id : string<br align="left"/>name : string<br align="left"/></td></tr></table>>];
 Expense [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#E4572E"><tr><td bgcolor="#E4572E"><font color="white"><b>Expense</b></font></td></tr><tr><td align="left">id : string<br align="left"/>title : string<br align="left"/>amountCents : int<br align="left"/>paidBy : string (→ Member)<br align="left"/>category : enum<br align="left"/>date : yyyy-mm-dd<br align="left"/>mode : equal|percent|exact|shares<br align="left"/>owed : Map&lt;Member, int&gt;<br align="left"/></td></tr></table>>];
 Settlement [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#D68A1C"><tr><td bgcolor="#D68A1C"><font color="white"><b>Settlement</b></font></td></tr><tr><td align="left">id : string<br align="left"/>from : string (→ Member)<br align="left"/>to : string (→ Member)<br align="left"/>amountCents : int<br align="left"/>date : yyyy-mm-dd<br align="left"/></td></tr></table>>];
 Group -> Member [label="  2..n  ", arrowhead=none, taillabel="1", headlabel="2..*", labeldistance=2.2];
 Group -> Expense [arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2];
 Group -> Settlement [arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2];
 Expense -> Member [style=dashed, label="paidBy / owed", constraint=false];
 Settlement -> Member [style=dashed, label="from / to", constraint=false];
}
